UR  - http://bb2sz3ek3z.search.serialssolutions.com/?url_ver=Z39.88-2004&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rfr_id=info:sid/Ovid:med4&rft.genre=article&rft_id=info:doi/10.1016%2Fs1091-255x%2801%2980010-x&rft_id=info:pmid/11309645&rft.issn=1091-255X&rft.volume=5&rft.issue=1&rft.spage=27&rft.pages=27-35&rft.date=2001&rft.jtitle=Journal+of+Gastrointestinal+Surgery&rft.atitle=Preoperative+chemoradiation+for+marginally+resectable+adenocarcinoma+of+the+pancreas.&rft.aulast=Mehta
